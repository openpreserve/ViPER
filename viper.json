{
  "variables": {
    "vm_name": "viper-v1.2-alpha",
    "cpus": "2",
    "memory": "4096",
    "disk_size": "51200",
    "headless": "false",
    "iso_url": "https://cdimage.debian.org/cdimage/archive/12.8.0/amd64/iso-cd/debian-12.8.0-amd64-netinst.iso",
    "iso_checksum": "sha256:04396d12b0f377958a070c38a923c227832fa3b3e18ddc013936ecf492e9fbb3"
  },
  "builders": [
    {
      "type": "qemu",
      "vm_name": "{{user `vm_name`}}",
      "iso_url": "{{user `iso_url`}}",
      "iso_checksum": "{{user `iso_checksum`}}",
      "output_directory": "output-qemu",
      "disk_size": "{{user `disk_size`}}",
      "disk_interface": "virtio",
      "disk_compression": true,
      "format": "qcow2",
      "cpus": "{{user `cpus`}}",
      "memory": "{{user `memory`}}",
      "headless": "{{user `headless`}}",
      "accelerator": "kvm",
      "vnc_bind_address": "127.0.0.1",
      "vnc_port_min": 5900,
      "vnc_port_max": 5900,
      "net_device": "virtio-net",
      "ssh_username": "vagrant",
      "ssh_password": "vagrant",
      "ssh_timeout": "30m",
      "ssh_port": 22,
      "shutdown_command": "echo 'vagrant' | sudo -S shutdown -P now",
      "boot_wait": "5s",
      "boot_command": [
        "<esc><wait>",
        "auto <wait>",
        "console-setup/ask_detect=false <wait>",
        "console-keymaps-at/keymap=us <wait>",
        "debconf/frontend=noninteractive <wait>",
        "debian-installer=en_US.UTF-8 <wait>",
        "fb=false <wait>",
        "install <wait>",
        "kbd-chooser/method=us <wait>",
        "keyboard-configuration/xkb-keymap=us <wait>",
        "locale=en_US.UTF-8 <wait>",
        "netcfg/get_hostname={{user `vm_name`}} <wait>",
        "netcfg/get_domain=viper.test <wait>",
        "preseed/url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/preseed.cfg <wait>",
        "<enter>"
      ],
      "http_directory": "http"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "echo 'Waiting for system to be ready...'",
        "sudo apt-get update"
      ]
    },
    {
      "type": "ansible",
      "playbook_file": "ansible/packer.yml",
      "inventory_file": "ansible/packer-inventory.yml",
      "user": "vagrant",
      "extra_arguments": ["-vv"]
    }
  ],
  "post-processors": [
    {
      "type": "shell-local",
      "inline": [
        "echo 'Build complete. Run ./scripts/convert-to-ova.sh to create OVA file.'"
      ]
    }
  ]
}
